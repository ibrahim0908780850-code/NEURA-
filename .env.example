# ==================================
# NEURA-1 Environment Configuration v0.9
# ==================================


# ==========================
# Application
# ==========================

APP_NAME=NEURA-1
APP_VERSION=0.9.0
ENVIRONMENT=production



# ==========================
# AI Model
# ==========================

BASE_MODEL=Qwen

MODEL_NAME=Qwen/Qwen3.5-9B

MODEL_PROVIDER=huggingface



# ==========================
# Server
# ==========================

HOST=0.0.0.0

PORT=8080



# ==========================
# Hugging Face Router API
# ==========================

HF_TOKEN=hf_your_token_here



# ==========================
# Database
# ==========================

DATABASE_ENABLED=false

DATABASE_URL=



# ==========================
# Supabase (Optional)
# ==========================

SUPABASE_URL=

SUPABASE_KEY=



# ==========================
# Memory System
# ==========================

MEMORY_ENABLED=true

MEMORY_TYPE=local



# ==========================
# Knowledge System
# ==========================

KNOWLEDGE_ENABLED=true

KNOWLEDGE_STORAGE=local



# ==========================
# Tools
# ==========================

TOOLS_ENABLED=true



# ==========================
# Web Search
# ==========================

WEB_SEARCH_ENABLED=true

TAVILY_API_KEY=your_tavily_key_here



# ==========================
# Code Agent
# ==========================

CODE_AGENT_ENABLED=true



# ==========================
# Security
# ==========================

API_SECRET_KEY=change_this_secret



# ==========================
# Logging
# ==========================

LOG_LEVEL=INFO